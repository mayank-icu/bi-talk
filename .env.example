# Groq API Key (get yours free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Server port (default: 3000)
PORT=3000

# Optional: TURN server for reliable NAT traversal across different networks
# Free option: metered.ca (https://www.metered.ca/tools/openrelay/)
TURN_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject

# Optional: Groq AI Model overrides
# WHISPER_MODEL=whisper-large-v3-turbo
# LLAMA_MODEL=llama-3.3-70b-versatile

# Upstash Redis — REQUIRED for Netlify production (shared state across serverless invocations)
# Create a free database at https://console.upstash.com → copy REST URL and token
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

